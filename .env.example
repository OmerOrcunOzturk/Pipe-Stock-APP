# Yerel sunucu kurulumunda (server/KURULUM.md) hiçbir değişken gerekmez:
# uygulama, açıldığı adresteki sunucuya bağlanır.
#
# Sadece uygulama başka bir adresteki sunucuya (ör. bir Supabase projesine)
# bağlanacaksa bu dosyayı .env.local olarak kopyalayıp değerleri doldurun.
# VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=
